PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/bookDatabase?retryWrites=true&w=majority

# Optional: only if the server fails with "querySrv ECONNREFUSED" (some VPNs, e.g.
# Cloudflare WARP, break the DNS lookup MongoDB Atlas needs). Not needed on Render.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Login for the website
ADMIN_USERNAME=
# bcrypt hash of the password; generate with: npm run hash-password -- "your-password"
# In this file, wrap the hash in single quotes because it contains $ characters.
ADMIN_PASSWORD_HASH=

# Book scanning (photo -> title/author/publisher). Set one or both keys.
# 1) Google Cloud (Agent Platform / Vertex AI) API key: paid per scan from your Google Cloud
#    credit, reliable, tried first. Create it in Cloud Console -> APIs & Services -> Credentials.
GOOGLE_VERTEX_API_KEY=
# Stop using the Cloud key once this month's estimated spend reaches this many US dollars
# (keep it below your monthly credit). Default 8.
# SCAN_MONTHLY_BUDGET_USD=8
# 2) Gemini API key from https://aistudio.google.com: free tier (about 20 scans/day), used as backup.
GEMINI_API_KEY=
# Optional: models to try in order, comma-separated (the next one is used when one is busy)
# GEMINI_CLOUD_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-3.5-flash
# GEMINI_MODELS=gemini-2.5-flash,gemini-3.8-flash,gemini-3.5-flash
